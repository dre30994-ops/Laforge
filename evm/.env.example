# Copy to `.env` and fill in. `.env` is git-ignored — never commit a real key.

# Funded TESTNET deployer private key (hex, 0x-prefixed). Use a throwaway
# testnet-only key. Fund it with Robinhood Chain testnet ETH from the faucet.
DEPLOYER_KEY=0x2ac3fd829df5a124e6917db843625b2486973ee96545f16d7409116592b099f2

# Optional RPC override (defaults to the public endpoint in hardhat.config.js).
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
